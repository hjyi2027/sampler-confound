# Copy to .env (which is gitignored) and fill in whichever you have.
# Every provider below is OpenAI-compatible; samplerconfound/provider.py routes
# by name. Run `python3 scripts/check_keys.py` to verify each one with a single
# cheap call.

FIREWORKS_API_KEY=        # https://fireworks.ai/
GROQ_API_KEY=             # https://console.groq.com/keys
CEREBRAS_API_KEY=         # https://cloud.cerebras.ai/
GOOGLE_API_KEY=           # https://aistudio.google.com/apikey
OPENROUTER_API_KEY=       # https://openrouter.ai/keys
NVIDIA_API_KEY=           # https://build.nvidia.com/
MISTRAL_API_KEY=          # https://console.mistral.ai/api-keys
